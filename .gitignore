# ---- Data (never commit datasets) ----
data/raw/*
!data/raw/.gitkeep
*.csv
*.xls
*.xlsx

# ---- MLflow (database + artifacts) ----
mlruns/
mlartifacts/
mlflow.db
*.db

# ---- Generated training outputs ----
artifacts/*
!artifacts/.gitkeep

# ---- Python ----
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/

# ---- Secrets / credentials ----
.env
.env.*
kaggle.json

# ---- OS / editors ----
.DS_Store
.vscode/
.idea/
!.env.example
